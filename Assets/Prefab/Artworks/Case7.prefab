  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Los realistas realizan movimientos que pueden encubrir partidas de hostigamiento.
    He ordenado reforzar el ala izquierda y mantener en alerta a los escuadrones
    del valle; aseguraos de que se cumpla estrictamente. La disciplina debe ser absoluta:
    formaciones diarias, revista de armas y ninguna patrulla sin orden escrita. El
    \xE1nimo de la tropa es bueno, pero la exactitud en los movimientos resulta esencial.\n\nInformadme
    con urgencia sobre las municiones, especialmente si el env\xEDo prometido no
    ha llegado.\n\nDios guarde vuestra vida.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2bd8f7192a0fc0c49b5d799829ef5287, type: 2}
